diff --git a/src/Client.php b/src/Client.php
index 5360e18809580b543684879c0153d03fc9d8879b..c3175fd35e4e56c57b8fa1619337d58b7fffd074 100644
--- a/src/Client.php
+++ b/src/Client.php
@@ -143,6 +143,27 @@ class Client implements ClientInterface {
 
     $url = static::API_BASE_URL . UrlHelper::encodePath(strtr($path, $replacements));
 
+    // Check tab permsissions.
+    $perms = [
+      'practices' => 'view dubbot practices tab',
+      'governace' => 'view dubbot governance tab',
+      'accessibility' => 'view dubbot accessibility tab',
+      'spellcheck' => 'view dubbot spellcheck tab',
+      'seo' => 'view dubbot seo tab',
+      'links' => 'view dubbot links tab',
+    ];
+    $tabs = [];
+
+    foreach ($perms as $tab => $perm) {
+      if (\Drupal::currentUser()->hasPermission($perm)) {
+        $tabs[] = $tab;
+      }
+    };
+
+    if (count($tabs)) {
+      $query['show'] = implode(',', $tabs);
+    }
+
     if (empty($query)) {
       return $url;
     }
